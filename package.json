{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "npm run build && npm run build:server && node dist-server/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js server.cjs build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.16",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "motion": "^12.23.24",
    "openai": "^7.28.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.0",
    "pg-format": "^1.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/pg-format": "^1.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.2"
  }
}
